# The repair agent uses the OpenAI-compatible Chat Completions interface.
# Put real credentials only in the ignored .env.models file.
MODEL_PROVIDER=deepseek
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MODEL_API_KEY=replace-with-real-key
MODEL_TIMEOUT_SECONDS=35
MODEL_MAX_RETRIES=1

# Any compatible provider can be used instead:
# MODEL_PROVIDER=openai-compatible
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=<model available to your account>
# MODEL_API_KEY=replace-with-real-key
